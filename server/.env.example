# Copy to server/.env and fill in. NEVER commit the real file.
# Read only by the Node process — the browser never sees this.
ANTHROPIC_API_KEY=sk-ant-...

# Which brain to run: "mock" (free, scripted) or "claude" (real API calls).
# Switchable at runtime via POST /engine — mock is always the fallback.
REALM_ENGINE=mock

# ── Cost guardrails (all enforced before any API call) ──
# Hard ceiling for the whole month, in GBP. Hitting it trips the kill switch.
REALM_MONTHLY_CEILING_GBP=5.00
# Max tokens any single tick may spend across all agents.
REALM_TICK_TOKEN_BUDGET=60000
# Max output tokens per agent call.
REALM_MAX_OUTPUT_TOKENS=1024

PORT=5200
